<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.maa_tauri_android" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Startup backdrop behind the edge-to-edge webview, which paints the same
             surface color token as its body background once React mounts. @color/surface
             resolves per configuration, so light and dark are covered by this one entry. -->
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <!-- @color/surface resolves the dark variant from values-night/colors.xml. -->
    <style name="Theme.maa_tauri_android.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.maa_tauri_android</item>
    </style>
</resources>
